# Copy to RL/.env. RL launchers load this file automatically.
# Configure your own checkpoint, services and credentials.
MODEL_PATH=/models/your-sft-checkpoint
OUTPUT_DIR=./outputs/rl
RL_DATASET_NAME=OneSearch-VL-RL-10K
# Current reward, enabled by default in both RL launchers.
FORMAL_EVGR_ENABLED=1
FORMAL_EVGR_MODE=both
FORMAL_EVGR_JUDGE_BACKEND=seed
# Total: format * (0.6 accuracy + 0.2 query + 0.2 mean(trace, ground)).
REWARD_ACCURACY_WEIGHT=0.6
REWARD_QUERY_WEIGHT=0.2
FORMAL_EVGR_PROCESS_WEIGHT=0.2
QUERY_REWARD_ENABLED=1
FORMAL_EVGR_MAX_CONCURRENCY=32
FORMAL_EVGR_EXPECTED_JUDGE_MODEL=Doubao-Seed-2.0-pro
EVGR_JUDGE_MODEL=Doubao-Seed-2.0-pro
EVGR_JUDGE_MAX_TOKENS=5000
EVGR_JUDGE_TIMEOUT=180
EVGR_JUDGE_MAX_ATTEMPTS=2
# OpenAI-compatible multimodal Seed endpoint; supply your own credentials.
SEED_API_BASE=
SEED_API_KEY=
EVGR_SPLIT_MAX_IMAGES=32
EVGR_SPLIT_IMAGE_EDGE=768
EVGR_SPLIT_MAX_TEXT_CHARS=200000
EVGR_SPLIT_VALIDATION_RETRIES=1
FORMAL_EVGR_SCORE_VALIDATION=0
# Blank uses ../OneSearch-VL-RL-10K next to the code repository.
# Relative paths use the code root.
FORMAL_EVGR_DATA_ROOT=

# OneSearch-VL retrieval providers.
# Direct mode: Serper search/Lens -> Jina reader -> OpenAI-compatible summary.
SERPER_API_KEY=
SERPER_SEARCH_URL=https://google.serper.dev/search
# Blank selects https://google.serper.dev/lens in direct mode.
# In gateway mode, set this to your gateway's Serper Lens endpoint.
IMAGE_SEARCH_URL=
JINA_API_KEY=
JINA_READER_URL=https://r.jina.ai/
QWEN_API_BASE=http://localhost:8000/v1
QWEN_API_KEY=
QWEN_MODEL_NAME=Qwen/Qwen3-32B
# Set false only for servers supporting chat_template_kwargs (e.g. Qwen/vLLM).
QWEN_ENABLE_THINKING=

# Optional upstream gateway mode. Set all three together; otherwise leave blank.
API_HOST=
API_USER=
API_KEY=

# Optional PP-Structure layout tool; no private OCR service is bundled.
LAYOUT_PARSING_API_URL=
LAYOUT_PARSING_TOKEN=
SEARCH_HTTP_TIMEOUT=30
SEARCH_MAX_RETRIES=3
TEXT_SEARCH_BACKEND_TIMEOUT=120
IMAGE_SEARCH_BACKEND_TIMEOUT=120
LAYOUT_PARSING_BACKEND_TIMEOUT=90
TEXT_SEARCH_MAX_CONCURRENCY=16
IMAGE_SEARCH_MAX_CONCURRENCY=16

# Publish crops to an existing static file server reachable by retrieval.
# ASSET_DIR is the served filesystem directory, not the URL itself.
ASSET_DIR=
ASSET_BASE_URL=

# RL accuracy and query judges (independent of Seed EVGR and inference).
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o
