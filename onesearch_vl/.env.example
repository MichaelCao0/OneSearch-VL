# Copy to onesearch_vl/.env. run_infer.sh and run_eval.sh load it automatically.
# For direct Python entry points: set -a; source onesearch_vl/.env; set +a
# Inference: an OpenAI-compatible vLLM/SGLang server, or --model 8b locally.
VLLM_API_BASE=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=onesearch-vl
VIDEO_FPS=2
VIDEO_MAX_PIXELS=100352
VIDEO_MAX_FRAMES=128

# Blank uses modality defaults: image/multi-image=onesearch, video=videodr.
# Optional override: onesearch or videodr. Both prefer boxed final answers.
EVAL_PROTOCOL=
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o
JUDGE_TIMEOUT=120
JUDGE_MAX_RETRY=3
JUDGE_RETRY_SLEEP=1

# OneSearch-VL retrieval providers.
# Direct mode: Serper search/Lens -> Jina reader -> OpenAI-compatible summary.
SERPER_API_KEY=
SERPER_SEARCH_URL=https://google.serper.dev/search
# Blank selects https://google.serper.dev/lens in direct mode.
# In gateway mode, set this to your gateway's Serper Lens endpoint.
IMAGE_SEARCH_URL=
JINA_API_KEY=
JINA_READER_URL=https://r.jina.ai/
QWEN_API_BASE=http://localhost:8000/v1
QWEN_API_KEY=
QWEN_MODEL_NAME=Qwen/Qwen3-32B
# Set false only for servers supporting chat_template_kwargs (e.g. Qwen/vLLM).
QWEN_ENABLE_THINKING=

# Optional upstream gateway mode. Set all three together; otherwise leave blank.
API_HOST=
API_USER=
API_KEY=

# Optional PP-Structure layout tool; no private OCR service is bundled.
LAYOUT_PARSING_API_URL=
LAYOUT_PARSING_TOKEN=
SEARCH_HTTP_TIMEOUT=30
SEARCH_MAX_RETRIES=3
TEXT_SEARCH_BACKEND_TIMEOUT=120
IMAGE_SEARCH_BACKEND_TIMEOUT=120
LAYOUT_PARSING_BACKEND_TIMEOUT=90
TEXT_SEARCH_MAX_CONCURRENCY=16
IMAGE_SEARCH_MAX_CONCURRENCY=16

# Publish crops to an existing static file server reachable by retrieval.
# ASSET_DIR is the served filesystem directory, not the URL itself.
ASSET_DIR=
ASSET_BASE_URL=

# Optional Claude inference via the public Messages API (claude / claude-api).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Seed inference backend; independent of RL reward judges.
SEED_API_BASE=
SEED_API_KEY=
SEED_MODEL=Doubao-Seed-2.0-pro
